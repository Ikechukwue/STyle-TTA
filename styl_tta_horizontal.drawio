        <mxCell id="box32" value="&lt;b style=&#x27;font-size:16px;&#x27;&gt;SOFT AGGREGATION&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;p̄(y|x) = 1/(K+1)&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;× [p₀ + Σ pᵢ]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;Probability averaging&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;preserves confidence information&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontColor=#E65100;align=center;verticalAlign=top;spacingTop=10;arcSize=8;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
