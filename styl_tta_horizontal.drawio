        <mxCell id="box18" value="&lt;b style=&#x27;font-size:16px;&#x27;&gt;STYLE TRANSFER&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;For each retrieved reference sᵢ:&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;x̃ᵢ = T(x, sᵢ)&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;StyleID / AdaIN&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;Target = content • sᵢ = appearance&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontColor=#6A1B9A;align=center;verticalAlign=top;spacingTop=10;arcSize=8;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
