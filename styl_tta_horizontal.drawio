        <mxCell id="box24" value="&lt;b style=&#x27;font-size:16px;&#x27;&gt;ENSEMBLE OF K+1 INPUT VIEWS&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;A(x) = {x, T(x,s₁), …, T(x,sₖ)}&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;Original target is explicitly retained&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#90A4AE;fontColor=#455A64;align=center;verticalAlign=top;spacingTop=10;arcSize=8;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
