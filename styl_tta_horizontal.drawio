        <mxCell id="box11" value="&lt;b style=&#x27;font-size:16px;&#x27;&gt;L2 NORMALIZATION&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;z = φ(x) / ‖φ(x)‖₂&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;Normalized embeddings&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;→ cosine similarity&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontColor=#E65100;align=center;verticalAlign=top;spacingTop=10;arcSize=8;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
