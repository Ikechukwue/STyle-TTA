        <mxCell id="box31" value="&lt;b style=&#x27;font-size:16px;&#x27;&gt;K+1 PREDICTION VECTORS&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;p₀ = pθ(y | x)&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;p₁, …, pₖ&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;Each vector ∈ ℝ|C|&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;probabilities over shared label space C&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#E65100;align=center;verticalAlign=top;spacingTop=10;arcSize=8;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
