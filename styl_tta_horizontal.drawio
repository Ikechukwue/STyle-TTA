        <mxCell id="box30" value="&lt;b style=&#x27;font-size:16px;&#x27;&gt;FROZEN CLASSIFIER&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;fθ&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;Each image evaluated independently&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;&#x27;&gt;pᵢ = softmax(fθ(viewᵢ))&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontColor=#0D47A1;align=center;verticalAlign=top;spacingTop=10;arcSize=8;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
